# ---------------------------------------------------------------------------
# ClientFlow environment template
#
# Usage:
#   cp .env.example .env.local
#   then replace the placeholder values with your own Supabase credentials.
#
# This file must NEVER contain real credentials. All values below are
# placeholders and are safe to commit.
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------------------

# Supabase project URL.
# Supabase dashboard -> Project Settings -> API -> Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public API key (safe for the browser; access is limited by RLS).
# Supabase dashboard -> Project Settings -> API -> Project API keys -> anon/public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Test-only variable (not used by the application at runtime)
#
# Postgres connection string used by the Row Level Security integration tests
# (`tests/db`). Local development: `supabase db reset` / a throwaway database.
# When it is unset those tests are skipped instead of failing.
#
# Never point this at a production database.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/clientflow_test
