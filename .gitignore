# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# Ignore every real environment file, but keep the template tracked.
# `.env.local` must never be committed: it holds real Supabase credentials.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# eslint
.eslintcache

# playwright
/playwright-report/
/blob-report/
/test-results/
/playwright/.cache/

# supabase local development state
/supabase/.branches/
/supabase/.temp/

# Agent instruction files generated automatically by `next dev`
# (see node_modules/next/dist/server/lib/generate-agent-files.js).
# They are tooling artifacts, not part of the ClientFlow application.
AGENTS.md
CLAUDE.md
